#!/bin/sh
set -eu
cd "$(dirname "$0")/.."

# Build into a temporary directory without removing the local preview.
build_dir=$(mktemp -d)
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM
script/build --destination "$build_dir"

test -s "$build_dir/index.html"
test -s "$build_dir/about/index.html"
test -s "$build_dir/assets/css/style.css"
test -s "$build_dir/blog/page2/index.html"
echo "Site build checks passed."
